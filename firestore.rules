rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath(uid) {
      return /databases/$(database)/documents/admins/$(uid);
    }

    function hasAdminDoc() {
      return signedIn() && exists(adminPath(request.auth.uid));
    }

    function adminData() {
      return get(adminPath(request.auth.uid)).data;
    }

    function isOwner() {
      return hasAdminDoc() && adminData().role == 'owner';
    }

    function nullableString(value) {
      return value == null || value is string;
    }

    function validCenterSource(value) {
      return value in ['url', 'manual', 'none'];
    }

    function validV1TestResultCreate() {
      return request.resource.data.keys().hasOnly([
          'participantName',
          'participantEmail',
          'centerName',
          'centerKey',
          'centerSource',
          'startedAt',
          'completedAt',
          'answers',
          'scores',
          'topCareer',
          'recommendedCareers',
          'resultSummary',
          'createdAt',
          'schemaVersion'
        ]) &&
        nullableString(request.resource.data.participantName) &&
        nullableString(request.resource.data.participantEmail) &&
        nullableString(request.resource.data.centerName) &&
        nullableString(request.resource.data.centerKey) &&
        validCenterSource(request.resource.data.centerSource) &&
        request.resource.data.startedAt is timestamp &&
        request.resource.data.completedAt is timestamp &&
        request.resource.data.answers is list &&
        request.resource.data.answers.size() <= 60 &&
        request.resource.data.scores is map &&
        request.resource.data.scores.keys().size() <= 30 &&
        (request.resource.data.topCareer is map || request.resource.data.topCareer is string) &&
        request.resource.data.recommendedCareers is list &&
        request.resource.data.recommendedCareers.size() <= 20 &&
        request.resource.data.resultSummary is string &&
        request.resource.data.resultSummary.size() <= 2000 &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.createdAt == request.time;
    }

    function validV2DreamChoice(value) {
      return value is map &&
        value.keys().hasOnly(['kind', 'careerName']) &&
        value.kind in ['recommended', 'catalog', 'custom', 'undecided'] &&
        (value.kind == 'undecided' || (value.careerName is string && value.careerName.size() <= 40));
    }

    function validV2AnswerSnapshot(value) {
      return value is map &&
        value.keys().hasOnly(['questionId', 'questionText', 'choice', 'optionLabel']) &&
        value.questionId is int && value.questionId >= 1 && value.questionId <= 24 &&
        value.questionText is string && value.questionText.size() <= 200 &&
        value.choice in ['A', 'B', 'unknown'] &&
        value.optionLabel is string && value.optionLabel.size() <= 240;
    }

    function validV2Career(value) {
      return value is map &&
        value.keys().hasOnly(['name', 'score', 'primaryField', 'secondaryField', 'reason']) &&
        value.keys().hasAll(['name', 'score', 'primaryField', 'reason']) &&
        value.name is string && value.name.size() <= 40 && value.score is number && value.score >= 0 && value.score <= 1 &&
        value.primaryField in ['research', 'digital', 'creative', 'people', 'life', 'leadership', 'public', 'action'] &&
        (!value.keys().hasAll(['secondaryField']) || value.secondaryField == null || value.secondaryField in ['research', 'digital', 'creative', 'people', 'life', 'leadership', 'public', 'action']) &&
        value.reason is string && value.reason.size() <= 300;
    }

    function validV2Evidence(value) {
      return value.size() <= 2 &&
        (value.size() < 1 || (value[0] is string && value[0].size() <= 240)) &&
        (value.size() < 2 || (value[1] is string && value[1].size() <= 240));
    }

    function validV2RecommendedCareers(value) {
      return value.size() <= 20 &&
        (value.size() < 1 || validV2Career(value[0])) && (value.size() < 2 || validV2Career(value[1])) &&
        (value.size() < 3 || validV2Career(value[2])) && (value.size() < 4 || validV2Career(value[3])) &&
        (value.size() < 5 || validV2Career(value[4])) && (value.size() < 6 || validV2Career(value[5])) &&
        (value.size() < 7 || validV2Career(value[6])) && (value.size() < 8 || validV2Career(value[7])) &&
        (value.size() < 9 || validV2Career(value[8])) && (value.size() < 10 || validV2Career(value[9])) &&
        (value.size() < 11 || validV2Career(value[10])) && (value.size() < 12 || validV2Career(value[11])) &&
        (value.size() < 13 || validV2Career(value[12])) && (value.size() < 14 || validV2Career(value[13])) &&
        (value.size() < 15 || validV2Career(value[14])) && (value.size() < 16 || validV2Career(value[15])) &&
        (value.size() < 17 || validV2Career(value[16])) && (value.size() < 18 || validV2Career(value[17])) &&
        (value.size() < 19 || validV2Career(value[18])) && (value.size() < 20 || validV2Career(value[19]));
    }

    function validV2Field(value) {
      return value is map &&
        value.keys().hasOnly(['fieldId', 'label', 'score', 'scoreBand', 'evidence', 'recommendedCareers']) &&
        value.fieldId in ['research', 'digital', 'creative', 'people', 'life', 'leadership', 'public', 'action'] &&
        value.label is string && value.label.size() <= 100 && value.score is number && value.score >= 0 && value.score <= 1 &&
        value.scoreBand in ['very-high', 'high', 'explore'] && value.evidence is list && validV2Evidence(value.evidence) &&
        value.recommendedCareers is list && validV2RecommendedCareers(value.recommendedCareers);
    }

    function validV2AnswerSnapshots(value) {
      return value.size() == 24 &&
        validV2AnswerSnapshot(value[0]) && validV2AnswerSnapshot(value[1]) && validV2AnswerSnapshot(value[2]) && validV2AnswerSnapshot(value[3]) &&
        validV2AnswerSnapshot(value[4]) && validV2AnswerSnapshot(value[5]) && validV2AnswerSnapshot(value[6]) && validV2AnswerSnapshot(value[7]) &&
        validV2AnswerSnapshot(value[8]) && validV2AnswerSnapshot(value[9]) && validV2AnswerSnapshot(value[10]) && validV2AnswerSnapshot(value[11]) &&
        validV2AnswerSnapshot(value[12]) && validV2AnswerSnapshot(value[13]) && validV2AnswerSnapshot(value[14]) && validV2AnswerSnapshot(value[15]) &&
        validV2AnswerSnapshot(value[16]) && validV2AnswerSnapshot(value[17]) && validV2AnswerSnapshot(value[18]) && validV2AnswerSnapshot(value[19]) &&
        validV2AnswerSnapshot(value[20]) && validV2AnswerSnapshot(value[21]) && validV2AnswerSnapshot(value[22]) && validV2AnswerSnapshot(value[23]);
    }

    function validV2Fields(value) {
      return value.size() == 8 &&
        validV2Field(value[0]) && validV2Field(value[1]) && validV2Field(value[2]) && validV2Field(value[3]) &&
        validV2Field(value[4]) && validV2Field(value[5]) && validV2Field(value[6]) && validV2Field(value[7]);
    }

    function validV2RecommendedFields(value) {
      return value.size() <= 3 &&
        (value.size() < 1 || validV2Field(value[0])) &&
        (value.size() < 2 || validV2Field(value[1])) &&
        (value.size() < 3 || validV2Field(value[2]));
    }

    function validV2TestResultCreate() {
      return request.resource.data.keys().hasOnly([
          'participantName',
          'participantEmail',
          'centerName',
          'centerKey',
          'centerSource',
          'startedAt',
          'completedAt',
          'questionnaireVersion',
          'answerSnapshots',
          'fieldResults',
          'recommendedFieldResults',
          'dreamChoice',
          'resultSummary',
          'createdAt',
          'schemaVersion'
        ]) &&
        nullableString(request.resource.data.participantName) &&
        nullableString(request.resource.data.participantEmail) &&
        nullableString(request.resource.data.centerName) &&
        nullableString(request.resource.data.centerKey) &&
        validCenterSource(request.resource.data.centerSource) &&
        request.resource.data.startedAt is timestamp &&
        request.resource.data.completedAt is timestamp &&
        request.resource.data.questionnaireVersion == 2 &&
        request.resource.data.answerSnapshots is list &&
        validV2AnswerSnapshots(request.resource.data.answerSnapshots) &&
        request.resource.data.fieldResults is list &&
        validV2Fields(request.resource.data.fieldResults) &&
        request.resource.data.recommendedFieldResults is list &&
        validV2RecommendedFields(request.resource.data.recommendedFieldResults) &&
        validV2DreamChoice(request.resource.data.dreamChoice) &&
        request.resource.data.resultSummary is string &&
        request.resource.data.resultSummary.size() <= 2000 &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.createdAt == request.time;
    }

    match /institutions/{institutionId} {
      // This MVP no longer uses institutions for center setup.
      // Keep this locked unless a future server-backed institution flow is added.
      allow read, write: if false;
    }

    match /testResults/{resultId} {
      // Public quiz users can create a result only.
      allow create: if validV1TestResultCreate() || validV2TestResultCreate();

      // The first admin MVP is owner-only. Owners can read all results and group
      // them by centerName/centerKey on the client. No client can edit/delete results.
      allow get, list: if isOwner();
      allow update, delete: if false;
    }

    match /admins/{uid} {
      // A signed-in user can read only their own admin profile for role checking.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
