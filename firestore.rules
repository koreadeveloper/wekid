rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath(uid) {
      return /databases/$(database)/documents/admins/$(uid);
    }

    function hasAdminDoc() {
      return signedIn() && exists(adminPath(request.auth.uid));
    }

    function adminData() {
      return get(adminPath(request.auth.uid)).data;
    }

    function isOwner() {
      return hasAdminDoc() && adminData().role == 'owner';
    }

    function nullableString(value) {
      return value == null || value is string;
    }

    function validCenterSource(value) {
      return value in ['url', 'manual', 'none'];
    }

    function validV1TestResultCreate() {
      return request.resource.data.keys().hasOnly([
          'participantName',
          'participantEmail',
          'centerName',
          'centerKey',
          'centerSource',
          'startedAt',
          'completedAt',
          'answers',
          'scores',
          'topCareer',
          'recommendedCareers',
          'resultSummary',
          'createdAt',
          'schemaVersion'
        ]) &&
        nullableString(request.resource.data.participantName) &&
        nullableString(request.resource.data.participantEmail) &&
        nullableString(request.resource.data.centerName) &&
        nullableString(request.resource.data.centerKey) &&
        validCenterSource(request.resource.data.centerSource) &&
        request.resource.data.startedAt is timestamp &&
        request.resource.data.completedAt is timestamp &&
        request.resource.data.answers is list &&
        request.resource.data.answers.size() <= 60 &&
        request.resource.data.scores is map &&
        request.resource.data.scores.keys().size() <= 30 &&
        (request.resource.data.topCareer is map || request.resource.data.topCareer is string) &&
        request.resource.data.recommendedCareers is list &&
        request.resource.data.recommendedCareers.size() <= 20 &&
        request.resource.data.resultSummary is string &&
        request.resource.data.resultSummary.size() <= 2000 &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.createdAt == request.time;
    }

    function validV2DreamChoice(value) {
      return value is map &&
        value.keys().hasOnly(['kind', 'careerName']) &&
        value.kind in ['recommended', 'catalog', 'custom', 'undecided'] &&
        (value.kind == 'undecided' || (value.careerName is string && value.careerName.size() <= 40));
    }

    function validV2TestResultCreate() {
      return request.resource.data.keys().hasOnly([
          'participantName',
          'participantEmail',
          'centerName',
          'centerKey',
          'centerSource',
          'startedAt',
          'completedAt',
          'questionnaireVersion',
          'answerSnapshots',
          'fieldResults',
          'recommendedFieldResults',
          'dreamChoice',
          'resultSummary',
          'createdAt',
          'schemaVersion'
        ]) &&
        nullableString(request.resource.data.participantName) &&
        nullableString(request.resource.data.participantEmail) &&
        nullableString(request.resource.data.centerName) &&
        nullableString(request.resource.data.centerKey) &&
        validCenterSource(request.resource.data.centerSource) &&
        request.resource.data.startedAt is timestamp &&
        request.resource.data.completedAt is timestamp &&
        request.resource.data.questionnaireVersion == 2 &&
        request.resource.data.answerSnapshots is list &&
        request.resource.data.answerSnapshots.size() <= 24 &&
        request.resource.data.fieldResults is list &&
        request.resource.data.fieldResults.size() <= 8 &&
        request.resource.data.recommendedFieldResults is list &&
        request.resource.data.recommendedFieldResults.size() <= 3 &&
        validV2DreamChoice(request.resource.data.dreamChoice) &&
        request.resource.data.resultSummary is string &&
        request.resource.data.resultSummary.size() <= 2000 &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.createdAt == request.time;
    }

    match /institutions/{institutionId} {
      // This MVP no longer uses institutions for center setup.
      // Keep this locked unless a future server-backed institution flow is added.
      allow read, write: if false;
    }

    match /testResults/{resultId} {
      // Public quiz users can create a result only.
      allow create: if validV1TestResultCreate() || validV2TestResultCreate();

      // The first admin MVP is owner-only. Owners can read all results and group
      // them by centerName/centerKey on the client. No client can edit/delete results.
      allow get, list: if isOwner();
      allow update, delete: if false;
    }

    match /admins/{uid} {
      // A signed-in user can read only their own admin profile for role checking.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
